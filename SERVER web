### Contenu proxy.py

```python
import asyncio, websockets

async def handler(ws, path=None):
    reader, writer = await asyncio.open_connection('127.0.0.1', 9090)
    async def tcp_to_ws():
        while True:
            data = await reader.read(512)
            if not data: break
            await ws.send(data.decode(errors='ignore'))
    async def ws_to_tcp():
        async for msg in ws:
            writer.write((msg if msg.endswith('\n') else msg + '\n').encode())
            await writer.drain()
    done, pending = await asyncio.wait(
        [asyncio.ensure_future(tcp_to_ws()),
         asyncio.ensure_future(ws_to_tcp())],
        return_when=asyncio.FIRST_COMPLETED)
    for t in pending: t.cancel()

async def main():
    async with websockets.serve(handler, '0.0.0.0', 8765):
        print('Proxy WebSocket actif sur :8765')
        await asyncio.Future()

asyncio.run(main())
```

